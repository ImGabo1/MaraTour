# Copia este archivo como .env (no lo subas a GitHub)

# --- Base de datos (database/ y backend/) ---
# Local con docker compose:
DATABASE_URL=postgres://turismo:turismo@localhost:5432/turismo
DATABASE_SSL=false

# En la nube: pega la connection string del proveedor y activa SSL.
# Neon → Dashboard → Connect: usa la "Pooled connection" (la que lleva -pooler).
# Si usas `neon init`, el CLI escribe esta URL en .env.local (también se lee).
# DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true

# --- Backend ---
PORT=3001
# Orígenes permitidos por CORS, separados por coma. Vacío = cualquiera (solo desarrollo).
# En producción pon la URL del front, sin barra final:
# CORS_ORIGINS=https://maratour.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Frontend (variables VITE_*, solo se leen al compilar) ---
# En producción: URL pública del backend, sin barra final.
VITE_API_URL=https://maratour-api.onrender.com
