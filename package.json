{
  "name": "turismo-maracaibo-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "PWA para impulsar el turismo en el municipio Maracaibo",
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:front": "npm run dev -w frontend",
    "dev:back": "npm run dev -w backend",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run migrate -w database",
    "db:seed": "npm run seed -w database",
    "db:check": "npm run check -w database",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
